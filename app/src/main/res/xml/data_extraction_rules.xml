<?xml version="1.0" encoding="utf-8"?>
<!--
  قواعد استخراج البيانات (أندرويد 12 فما فوق).
  تمنع خروج قاعدة بيانات المرضى عبر النسخ السحابي أو نقل بيانات الجهاز.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dental_lab_database.db" />
        <exclude domain="database" path="dental_lab_database.db-shm" />
        <exclude domain="database" path="dental_lab_database.db-wal" />
        <exclude domain="sharedpref" path="aqlan_lab_prefs.xml" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dental_lab_database.db" />
        <exclude domain="database" path="dental_lab_database.db-shm" />
        <exclude domain="database" path="dental_lab_database.db-wal" />
        <exclude domain="sharedpref" path="aqlan_lab_prefs.xml" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
