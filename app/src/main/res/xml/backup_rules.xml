<?xml version="1.0" encoding="utf-8"?>
<!--
  قواعد النسخ الاحتياطي (أندرويد 11 وما دون).
  النسخ الاحتياطي معطّل أصلاً عبر android:allowBackup="false"، وهذه القواعد
  طبقة دفاع ثانية تستثني صراحةً قاعدة بيانات المرضى والإعدادات.
-->
<full-backup-content>
    <exclude domain="database" path="dental_lab_database.db" />
    <exclude domain="database" path="dental_lab_database.db-shm" />
    <exclude domain="database" path="dental_lab_database.db-wal" />
    <exclude domain="sharedpref" path="aqlan_lab_prefs.xml" />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
