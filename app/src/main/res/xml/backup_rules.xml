<?xml version="1.0" encoding="utf-8"?><!--
  SECURITY FIX: the local Room database stores patient data (PHI), financial records
  and salted PIN hashes, and SharedPreferences store gateway API keys. None of this
  may ever leave the device via Android's auto-backup. allowBackup is disabled in the
  manifest; these rules additionally exclude the sensitive domains in case the flag
  is ever re-enabled.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
